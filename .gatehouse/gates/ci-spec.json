{
  "scope": {
    "include": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      ".github/workflows/**",
      "ci/**",
      "crates/**",
      "scripts/**",
      "docs/assurance/**",
      ".gatehouse/**"
    ],
    "exclude": [],
    "external": [],
    "git_history": false
  },
  "env": {
    "image": "gatehouse/nucleus-gate-tools@sha256:83265724d7bb1af70cc1377229f6840f84029efddb66438a94c28c278450297c",
    "platform": "linux/arm64",
    "toolchains": {
      "rust": "1.96.1"
    },
    "env_vars": {}
  },
  "cap": {
    "net": "none",
    "fs_read": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      ".github/workflows/**",
      "ci/**",
      "crates/**",
      "scripts/**",
      "docs/assurance/**",
      ".gatehouse/**"
    ],
    "fs_write": [
      "target/**",
      "sdks/verifier-js/pkg/**",
      "sdks/verifier-js/target/**"
    ],
    "exec": "scoped",
    "wall_ms": 1200000,
    "cpu_ms": 1200000,
    "mem_mb": 4096,
    "secrets": []
  },
  "cmd": [],
  "steps": [
    {
      "program": "scripts/check-ci-spec.sh",
      "reads": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".github/workflows/**",
        "ci/**",
        "crates/**",
        "scripts/**",
        "docs/assurance/**",
        ".gatehouse/**"
      ],
      "writes": [
        "target/**",
        "sdks/verifier-js/pkg/**",
        "sdks/verifier-js/target/**"
      ]
    },
    {
      "program": "scripts/check-ci-assurance-ledger.sh",
      "reads": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".github/workflows/**",
        "ci/**",
        "crates/**",
        "scripts/**",
        "docs/assurance/**",
        ".gatehouse/**"
      ],
      "writes": [
        "target/**",
        "sdks/verifier-js/pkg/**",
        "sdks/verifier-js/target/**"
      ]
    },
    {
      "program": "cargo",
      "args": [
        "run",
        "-q",
        "--offline",
        "-p",
        "xtask",
        "--",
        "assurance-required"
      ],
      "reads": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".github/workflows/**",
        "ci/**",
        "crates/**",
        "scripts/**",
        "docs/assurance/**",
        ".gatehouse/**"
      ],
      "writes": [
        "target/**",
        "sdks/verifier-js/pkg/**",
        "sdks/verifier-js/target/**"
      ]
    }
  ],
  "tools": [
    "sh@0.5.12",
    "cargo@1.96.1",
    "rustc@1.96.1",
    "git@2.39.5"
  ],
  "cwd": "",
  "timeout_s": 950,
  "outputs": [],
  "resources": {
    "cpus": 2,
    "mem_mb": 4096,
    "disk_mb": 4096
  },
  "falsifier": null,
  "seeds": [
    "warm@sha256:f84b9b6862fdac743bc228dd13c545cfa425dc55101c4a4ab342ce5ccf8cd288"
  ]
}

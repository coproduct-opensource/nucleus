{
  "scope": {
    "include": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      ".github/workflows/**",
      "ci/**",
      "crates/**",
      "scripts/**",
      "docs/assurance/**",
      ".gatehouse/**"
    ],
    "exclude": [],
    "external": [],
    "git_history": false
  },
  "env": {
    "image": "gatehouse/nucleus-gate-tools@sha256:5ddf312fc2864c1d8c4287173a9aeaee3a52c45bac14acfbeee960c35778fa95",
    "platform": "linux/arm64",
    "toolchains": {
      "rust": "1.96.1"
    },
    "env_vars": {},
    "pins": [
      {
        "platform": "linux/arm64",
        "image": "gatehouse/nucleus-gate-tools@sha256:5ddf312fc2864c1d8c4287173a9aeaee3a52c45bac14acfbeee960c35778fa95"
      },
      {
        "platform": "linux/amd64",
        "image": "gatehouse/nucleus-gate-tools@sha256:16adf89bcb4aedc98b4e8a9a46569fa6d9b5b2626cd5cd1ab7f602ec551402a8"
      }
    ]
  },
  "cap": {
    "net": "none",
    "fs_read": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      ".github/workflows/**",
      "ci/**",
      "crates/**",
      "scripts/**",
      "docs/assurance/**",
      ".gatehouse/**"
    ],
    "fs_write": [
      "target/**",
      "sdks/verifier-js/pkg/**",
      "sdks/verifier-js/target/**"
    ],
    "exec": "scoped",
    "wall_ms": 1200000,
    "cpu_ms": 1200000,
    "mem_mb": 4096,
    "secrets": []
  },
  "cmd": [],
  "steps": [
    {
      "program": "scripts/check-ci-spec.sh",
      "reads": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".github/workflows/**",
        "ci/**",
        "crates/**",
        "scripts/**",
        "docs/assurance/**",
        ".gatehouse/**"
      ],
      "writes": [
        "target/**",
        "sdks/verifier-js/pkg/**",
        "sdks/verifier-js/target/**"
      ]
    },
    {
      "program": "scripts/check-ci-assurance-ledger.sh",
      "reads": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".github/workflows/**",
        "ci/**",
        "crates/**",
        "scripts/**",
        "docs/assurance/**",
        ".gatehouse/**"
      ],
      "writes": [
        "target/**",
        "sdks/verifier-js/pkg/**",
        "sdks/verifier-js/target/**"
      ]
    },
    {
      "program": "cargo",
      "args": [
        "run",
        "-q",
        "--offline",
        "-p",
        "xtask",
        "--",
        "assurance-required"
      ],
      "reads": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".github/workflows/**",
        "ci/**",
        "crates/**",
        "scripts/**",
        "docs/assurance/**",
        ".gatehouse/**"
      ],
      "writes": [
        "target/**",
        "sdks/verifier-js/pkg/**",
        "sdks/verifier-js/target/**"
      ]
    }
  ],
  "tools": [
    "sh@0.5.12",
    "cargo@1.96.1",
    "rustc@1.96.1",
    "git@2.39.5"
  ],
  "cwd": "",
  "timeout_s": 950,
  "outputs": [],
  "resources": {
    "cpus": 2,
    "mem_mb": 4096,
    "disk_mb": 4096
  },
  "falsifier": null,
  "seeds": []
}

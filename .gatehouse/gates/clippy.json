{
  "scope": {
    "include": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      ".cargo/config.toml",
      "clippy.toml",
      "crates/**",
      "tests/**",
      "benchmarks/**",
      "scripts/**",
      "sdks/verifier-js/**",
      "examples/independent-conformance/**"
    ],
    "exclude": [],
    "external": [],
    "git_history": false
  },
  "env": {
    "image": "gatehouse/nucleus-gate-tools@sha256:83265724d7bb1af70cc1377229f6840f84029efddb66438a94c28c278450297c",
    "platform": "linux/arm64",
    "toolchains": {
      "rust": "1.96.1"
    },
    "env_vars": {}
  },
  "cap": {
    "net": "none",
    "fs_read": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      ".cargo/config.toml",
      "clippy.toml",
      "crates/**",
      "tests/**",
      "benchmarks/**",
      "scripts/**",
      "sdks/verifier-js/**",
      "examples/independent-conformance/**"
    ],
    "fs_write": [
      "target/**",
      "sdks/verifier-js/pkg/**",
      "sdks/verifier-js/target/**"
    ],
    "exec": "scoped",
    "wall_ms": 2400000,
    "cpu_ms": 2400000,
    "mem_mb": 8192,
    "secrets": []
  },
  "cmd": [
    "sh",
    "-c",
    "scripts/gatehouse-verifier-sdk.sh && cargo clippy --offline --all-targets --all-features --locked -- -D warnings && cargo clippy --offline -p portcullis --all-targets --locked -- -D warnings"
  ],
  "cwd": "",
  "timeout_s": 2400,
  "outputs": [],
  "resources": {
    "cpus": 2,
    "mem_mb": 8192,
    "disk_mb": 4096
  },
  "falsifier": null
}

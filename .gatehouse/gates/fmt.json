{
  "scope": {
    "include": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      "crates/**",
      "tests/**",
      "benchmarks/**",
      "scripts/**",
      "sdks/verifier-js/Cargo.toml",
      "sdks/verifier-js/Cargo.lock",
      "sdks/verifier-js/package.json",
      "sdks/verifier-js/index.js",
      "sdks/verifier-js/index.d.ts",
      "sdks/verifier-js/src/**",
      "sdks/verifier-js/test/**",
      "sdks/verifier-js/tests/**",
      "sdks/verifier-js/demo-fixtures/**"
    ],
    "exclude": [],
    "external": [],
    "git_history": false
  },
  "env": {
    "image": "gatehouse/nucleus-gate-tools@sha256:83265724d7bb1af70cc1377229f6840f84029efddb66438a94c28c278450297c",
    "platform": "linux/arm64",
    "toolchains": {
      "rust": "1.96.1"
    },
    "env_vars": {}
  },
  "cap": {
    "net": "none",
    "fs_read": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      "crates/**",
      "tests/**",
      "benchmarks/**",
      "scripts/**",
      "sdks/verifier-js/Cargo.toml",
      "sdks/verifier-js/Cargo.lock",
      "sdks/verifier-js/package.json",
      "sdks/verifier-js/index.js",
      "sdks/verifier-js/index.d.ts",
      "sdks/verifier-js/src/**",
      "sdks/verifier-js/test/**",
      "sdks/verifier-js/tests/**",
      "sdks/verifier-js/demo-fixtures/**"
    ],
    "fs_write": [
      "target/**",
      "sdks/verifier-js/pkg/**",
      "sdks/verifier-js/target/**"
    ],
    "exec": "scoped",
    "wall_ms": 600000,
    "cpu_ms": 600000,
    "mem_mb": 4096,
    "secrets": []
  },
  "cmd": [],
  "steps": [
    {
      "program": "cargo",
      "args": [
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "reads": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "crates/**",
        "tests/**",
        "benchmarks/**",
        "scripts/**",
        "sdks/verifier-js/Cargo.toml",
        "sdks/verifier-js/Cargo.lock",
        "sdks/verifier-js/package.json",
        "sdks/verifier-js/index.js",
        "sdks/verifier-js/index.d.ts",
        "sdks/verifier-js/src/**",
        "sdks/verifier-js/test/**",
        "sdks/verifier-js/tests/**",
        "sdks/verifier-js/demo-fixtures/**"
      ],
      "writes": [
        "target/**",
        "sdks/verifier-js/pkg/**",
        "sdks/verifier-js/target/**"
      ]
    }
  ],
  "tools": [
    "cargo@1.96.1",
    "rustfmt@1.9.0"
  ],
  "cwd": "",
  "timeout_s": 450,
  "outputs": [],
  "resources": {
    "cpus": 2,
    "mem_mb": 4096,
    "disk_mb": 4096
  },
  "falsifier": null
}

{
  "scope": {
    "include": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      "crates/**",
      "tests/**",
      "benchmarks/**",
      "scripts/**",
      "sdks/verifier-js/**"
    ],
    "exclude": [],
    "external": [],
    "git_history": false
  },
  "env": {
    "image": "docker.io/library/rust@sha256:e18a79fc84dfcfc3ab5ba72290398a644c135c97eaa881447fddc354ee4701a3",
    "platform": "linux/amd64",
    "toolchains": {
      "rust": "1.96.1"
    },
    "env_vars": {}
  },
  "cap": {
    "net": "none",
    "fs_read": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      "crates/**",
      "tests/**",
      "benchmarks/**",
      "scripts/**",
      "sdks/verifier-js/**"
    ],
    "fs_write": [
      "target/**",
      "sdks/verifier-js/pkg/**",
      "sdks/verifier-js/target/**"
    ],
    "exec": "scoped",
    "wall_ms": 3600000,
    "cpu_ms": 3600000,
    "mem_mb": 8192,
    "secrets": []
  },
  "cmd": [
    "sh",
    "-c",
    "mkdir -p /work/.cache && cp -a /opt/gatehouse/cache/. /work/.cache/ && CARGO_HOME=/opt/gatehouse/cargo-js XDG_CACHE_HOME=/work/.cache wasm-pack build sdks/verifier-js --target web --release && cargo test --offline --all-features --locked --lib --bins --tests"
  ],
  "cwd": "",
  "timeout_s": 3600,
  "outputs": [],
  "resources": {
    "cpus": 2,
    "mem_mb": 8192,
    "disk_mb": 4096
  },
  "falsifier": null
}

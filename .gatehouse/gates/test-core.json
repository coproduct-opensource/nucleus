{
  "scope": {
    "include": [
      "**"
    ],
    "exclude": [],
    "external": [],
    "git_history": true
  },
  "env": {
    "image": "gatehouse/nucleus-gate-tools@sha256:83265724d7bb1af70cc1377229f6840f84029efddb66438a94c28c278450297c",
    "platform": "linux/arm64",
    "toolchains": {
      "rust": "1.96.1"
    },
    "env_vars": {}
  },
  "cap": {
    "net": "none",
    "fs_read": [
      "**"
    ],
    "fs_write": [
      "target/**",
      "sdks/verifier-js/pkg/**",
      "sdks/verifier-js/target/**"
    ],
    "exec": "scoped",
    "wall_ms": 3600000,
    "cpu_ms": 3600000,
    "mem_mb": 8192,
    "secrets": []
  },
  "cmd": [
    "sh",
    "-c",
    "scripts/gatehouse-verifier-sdk.sh && unshare -Urn sh -c '/usr/sbin/ip link set lo up && exec unshare -U --map-user=1001 --map-group=1001 cargo nextest run --offline --locked --all-features --no-fail-fast'"
  ],
  "tools": [
    "sh@0.5.12",
    "cargo@1.96.1",
    "rustc@1.96.1",
    "cargo-nextest@0.9.145",
    "wasm-pack@0.13.1",
    "wasm-bindgen@0.2.122",
    "unshare@2.38.1",
    "ip@6.1.0",
    "git@2.39.5"
  ],
  "cwd": "",
  "timeout_s": 2100,
  "outputs": [],
  "resources": {
    "cpus": 2,
    "mem_mb": 8192,
    "disk_mb": 8192
  },
  "falsifier": null,
  "seeds": [
    "warm@sha256:f84b9b6862fdac743bc228dd13c545cfa425dc55101c4a4ab342ce5ccf8cd288"
  ]
}

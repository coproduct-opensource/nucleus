{
  "scope": {
    "include": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      ".cargo/**",
      ".github/workflows/**",
      ".sandbox-unpinned-ceiling",
      "crates/**",
      "docs/**",
      "kani-divergence.toml",
      "sandbox-trusted-base.txt",
      "scripts/**",
      "tests/**"
    ],
    "exclude": [],
    "external": [],
    "git_history": false
  },
  "env": {
    "image": "gatehouse/nucleus-gate-tools@sha256:7b426459fd8e584eb372143baab851b1859117806129a3d4666f056978033be4",
    "platform": "linux/arm64",
    "toolchains": {
      "rust": "1.96.1"
    },
    "env_vars": {},
    "pins": [
      {
        "platform": "linux/arm64",
        "image": "gatehouse/nucleus-gate-tools@sha256:7b426459fd8e584eb372143baab851b1859117806129a3d4666f056978033be4"
      },
      {
        "platform": "linux/amd64",
        "image": "gatehouse/nucleus-gate-tools@sha256:16adf89bcb4aedc98b4e8a9a46569fa6d9b5b2626cd5cd1ab7f602ec551402a8"
      }
    ]
  },
  "cap": {
    "net": "none",
    "fs_read": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      ".cargo/**",
      ".github/workflows/**",
      ".sandbox-unpinned-ceiling",
      "crates/**",
      "docs/**",
      "kani-divergence.toml",
      "sandbox-trusted-base.txt",
      "scripts/**",
      "tests/**"
    ],
    "fs_write": [
      "target/**"
    ],
    "exec": "scoped",
    "wall_ms": 360000,
    "cpu_ms": 360000,
    "mem_mb": 2048,
    "secrets": []
  },
  "cmd": [],
  "steps": [
    {
      "program": "cargo",
      "args": [
        "run",
        "--quiet",
        "--offline",
        "--locked",
        "--jobs",
        "2",
        "--config",
        "profile.dev.debug=0",
        "--config",
        "profile.dev.incremental=false",
        "-p",
        "nucleus-escape-canary",
        "--",
        "--in-disposable-guest"
      ],
      "reads": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        ".cargo/**",
        ".github/workflows/**",
        ".sandbox-unpinned-ceiling",
        "crates/**",
        "docs/**",
        "kani-divergence.toml",
        "sandbox-trusted-base.txt",
        "scripts/**",
        "tests/**"
      ],
      "writes": [
        "target/**"
      ]
    },
    {
      "program": "scripts/check-north-star-ledger.sh",
      "reads": [
        ".github/workflows/**",
        ".sandbox-unpinned-ceiling",
        "crates/**",
        "docs/**",
        "kani-divergence.toml",
        "sandbox-trusted-base.txt",
        "scripts/**",
        "tests/**"
      ]
    }
  ],
  "tools": [
    "sh@0.5.12",
    "git@2.39.5",
    "rg@13.0.0",
    "awk@mawk-1.3.4",
    "python3@3.11.2",
    "cargo@1.96.1",
    "rustc@1.96.1"
  ],
  "cwd": "",
  "timeout_s": 360,
  "outputs": [],
  "resources": {
    "cpus": 2,
    "mem_mb": 2048,
    "disk_mb": 4096
  },
  "falsifier": null
}

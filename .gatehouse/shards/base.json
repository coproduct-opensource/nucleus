    "mem_mb": 8192,
    "secrets": []
  },
  "cmd": [],
  "steps": [
    {
      "program": "scripts/gatehouse-verifier-sdk.sh",
      "checkout_at": "/data/work/nucleus/nucleus",
      "reads": [
        "**",
        "scripts/**"
      ],
      "writes": [
        "target/**",
        "sdks/verifier-js/pkg/**",
        "sdks/verifier-js/target/**"
      ]
    },
    {
      "program": "cargo",
      "args": [
        "nextest",
        "run",
        "--offline",
        "--locked",
        "--all-features",
        "--no-fail-fast",
        "--no-tests=fail"
      ],
      "reads": [
        "**",
        "scripts/**"
      ],
      "writes": [
        "target/**",
        "sdks/verifier-js/pkg/**",
        "sdks/verifier-js/target/**"
      ],
      "loopback": true,
      "uid": 1001
    }
  ],
  "tools": [
    "sh@0.5.12",
    "cargo@1.96.1",
    "rustc@1.96.1",
    "cargo-nextest@0.9.145",
    "wasm-pack@0.13.1",
    "wasm-bindgen@0.2.122",
